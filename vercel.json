{
  "version": 2,
  "routes": [
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/admin-users/([0-9]+)", "dest": "/admin-user-detail.html?id=$1" },
    { "src": "/admin-users", "dest": "/admin-users.html" },
    { "src": "/signup", "dest": "/signup.html" },
    { "src": "/login", "dest": "/login.html" },
    { "src": "/profile", "dest": "/profile.html" },
    { "src": "/fifa-match/([0-9]+)", "dest": "/fifa-match.html?id=$1" },
    { "src": "/fifa-match", "dest": "/fifa-match.html" },
    { "src": "/api/logout", "dest": "/api/auth-misc?action=logout" },
    { "src": "/api/token", "dest": "/api/auth-misc" },
    { "src": "/api/(.*)", "dest": "/api/$1" }
  ]
}
